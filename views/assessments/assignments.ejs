<%- include('../partials/head') %>
  <%- include('../partials/navbar') %>

    <main class="container my-5">
      <%- include('../partials/flash') %>

        <div class="d-flex justify-content-between align-items-center mb-4">
          <h1>Assignments: <%= course.title %>
          </h1>
          <a href="<%= role === 'Student' ? '/my-courses' : '/courses/manage' %>" class="btn btn-outline-secondary">Back
            to Courses</a>
        </div>

        <% if (role==='Instructor' || role==='Admin' ) { %>
          <div class="card mb-5">
            <div class="card-header bg-primary text-white">
              <h3 class="h5 mb-0">Create New Assignment</h3>
            </div>
            <div class="card-body">
              <form action="/courses/<%= course.course_id %>/assignments" method="POST">
                <div class="mb-3">
                  <label for="title" class="form-label">Title</label>
                  <input type="text" class="form-control" id="title" name="title" required>
                </div>
                <div class="mb-3">
                  <label for="description" class="form-label">Description</label>
                  <textarea class="form-control" id="description" name="description" rows="3"></textarea>
                </div>
                <div class="row mb-3">
                  <div class="col-md-4">
                    <label for="max_marks" class="form-label">Max Marks</label>
                    <input type="number" step="0.01" min="1" class="form-control" id="max_marks" name="max_marks"
                      required>
                  </div>
                  <div class="col-md-4">
                    <label for="due_date" class="form-label">Due Date</label>
                    <input type="datetime-local" class="form-control" id="due_date" name="due_date" required>
                  </div>
                  <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check mb-2">
                      <input class="form-check-input" type="checkbox" id="late_submission_allowed"
                        name="late_submission_allowed" value="true">
                      <label class="form-check-label" for="late_submission_allowed">
                        Allow Late Submission
                      </label>
                    </div>
                  </div>
                </div>
                <button type="submit" class="btn btn-success">Create Assignment</button>
              </form>
            </div>
          </div>
          <% } %>

            <h2 class="mb-3">Assignment List</h2>
            <% if (assignments && assignments.length> 0) { %>
              <div class="row row-cols-1 row-cols-md-2 g-4">
                <% assignments.forEach(assignment=> {
                  const dueDate = new Date(assignment.due_date);
                  const now = new Date();
                  const isPastDue = now > dueDate;
                  const sub = role === 'Student' ? userSubmissions[assignment.assignment_id] : null;
                  %>
                  <div class="col">
                    <div class="card h-100 <%= isPastDue ? 'border-danger' : 'border-primary' %>">
                      <div class="card-body">
                        <h5 class="card-title">
                          <%= assignment.title %>
                        </h5>
                        <p class="card-text text-muted">
                          <%= assignment.description || 'No description provided.' %>
                        </p>
                        <ul class="list-unstyled">
                          <li><strong>Max Marks:</strong>
                            <%= assignment.max_marks %>
                          </li>
                          <li><strong>Due Date:</strong>
                            <%= dueDate.toLocaleString() %>
                          </li>
                          <li><strong>Late Submissions:</strong>
                            <%= assignment.late_submission_allowed ? 'Allowed' : 'Not Allowed' %>
                          </li>
                        </ul>

                        <% if (role==='Student' ) { %>
                          <hr>
                          <% if (sub) { %>
                            <div class="alert alert-success p-2">
                              <i class="fas fa-check-circle"></i> Submitted on <%= new
                                Date(sub.submission_date).toLocaleString() %><br>
                                <a href="<%= sub.file_url %>" target="_blank" class="alert-link">View File</a>
                            </div>
                            <% if (sub.marks_obtained !==null) { %>
                              <div class="bg-light p-3 rounded">
                                <strong>Marks:</strong>
                                <%= sub.marks_obtained %> / <%= assignment.max_marks %><br>
                                    <strong>Feedback:</strong>
                                    <%= sub.feedback || 'None' %>
                              </div>
                              <% } else { %>
                                <span class="text-info">Pending Grading</span>
                                <% } %>
                                  <% } else if (isPastDue && !assignment.late_submission_allowed) { %>
                                    <div class="alert alert-danger p-2 mb-0">
                                      <i class="fas fa-times-circle"></i> Deadline passed
                                    </div>
                                    <% } else { %>
                                      <form
                                        action="/courses/<%= course.course_id %>/assignments/<%= assignment.assignment_id %>/submit"
                                        method="POST" enctype="multipart/form-data">
                                        <div class="mb-3">
                                          <label for="assignment_file_<%= assignment.assignment_id %>"
                                            class="form-label">Upload Submission</label>
                                          <input class="form-control form-control-sm"
                                            id="assignment_file_<%= assignment.assignment_id %>" type="file"
                                            name="assignment_file" required>
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-sm">Submit Assignment</button>
                                      </form>
                                      <% } %>
                                        <% } else if (role==='Instructor' || role==='Admin' ) { %>
                                          <hr>
                                          <a href="/courses/<%= course.course_id %>/assignments/<%= assignment.assignment_id %>"
                                            class="btn btn-outline-primary btn-sm">View Submissions & Grade</a>
                                          <% } %>
                      </div>
                    </div>
                  </div>
                  <% }) %>
              </div>
              <% } else { %>
                <div class="alert alert-info">No assignments created for this course yet.</div>
                <% } %>

    </main>

    <%- include('../partials/footer') %>