<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="container">
    <div style="margin-top: var(--space-4);">
      <%- include('../partials/flash') %>
    </div>

    <div style="margin-bottom: var(--space-4);">
      <a href="/dashboard/admin" style="font-size: 0.875rem; color: var(--text-muted); text-decoration: none;">
        &larr; Back to Admin Control Center
      </a>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: var(--space-2); flex-wrap: wrap; gap: var(--space-2);">
        <div>
          <h1 style="font-family: var(--font-display); color: var(--ink-navy); font-size: 2rem;">User Management</h1>
          <p style="color: var(--text-muted); font-size: 0.95rem;">
            Total registered accounts: <strong><%= users.length %></strong>
          </p>
        </div>
      </div>
    </div>

    <div class="card" style="background: var(--white); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: var(--space-3); box-shadow: var(--shadow-subtle);">
      <div style="overflow-x: auto;">
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>User</th>
              <th>Role</th>
              <th>Phone</th>
              <th>Registered</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length > 0) { %>
              <% users.forEach(u => { %>
                <tr>
                  <td>#<%= u.user_id %></td>
                  <td>
                    <strong><%= u.name %></strong>
                    <% if (u.user_id === user.user_id) { %>
                      <span style="font-size: 0.75rem; background: var(--parchment); padding: 2px 6px; border-radius: 4px; color: var(--ink-navy); margin-left: 4px;">You</span>
                    <% } %>
                    <br>
                    <small style="color: var(--text-muted);"><%= u.email %></small>
                  </td>
                  <td>
                    <span class="user-badge" style="background: <%= u.role_name === 'Admin' ? 'var(--gold)' : (u.role_name === 'Instructor' ? 'var(--deep-indigo)' : 'var(--ink-navy)') %>; color: <%= u.role_name === 'Admin' ? 'var(--ink-navy)' : '#ffffff' %>;">
                      <%= u.role_name %>
                    </span>
                  </td>
                  <td><%= u.phone || '—' %></td>
                  <td><%= new Date(u.created_at).toLocaleDateString() %></td>
                  <td>
                    <% if (u.status === 'active') { %>
                      <span class="badge" style="background: #E8F5E9; color: var(--verdant); border: 1px solid #C8E6C9; padding: 3px 8px; border-radius: var(--radius-sm); font-weight: 600; font-size: 0.8rem;">
                        Active
                      </span>
                    <% } else if (u.status === 'banned') { %>
                      <span class="badge" style="background: var(--danger-bg); color: var(--danger); border: 1px solid #FADBD8; padding: 3px 8px; border-radius: var(--radius-sm); font-weight: 600; font-size: 0.8rem;">
                        Banned
                      </span>
                    <% } else { %>
                      <span class="badge" style="background: var(--parchment); color: var(--text-muted); border: 1px solid var(--border-subtle); padding: 3px 8px; border-radius: var(--radius-sm); font-weight: 600; font-size: 0.8rem;">
                        <%= u.status %>
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <% if (u.user_id !== user.user_id) { %>
                      <form action="/admin/users/<%= u.user_id %>/status" method="POST" style="display: inline-flex; gap: 4px; align-items: center;">
                        <select name="status" style="padding: 4px 8px; font-size: 0.85rem; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); background: var(--parchment);">
                          <option value="active" <%= u.status === 'active' ? 'selected' : '' %>>Active</option>
                          <option value="inactive" <%= u.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                          <option value="banned" <%= u.status === 'banned' ? 'selected' : '' %>>Banned</option>
                        </select>
                        <button type="submit" class="btn btn-secondary btn-sm" style="padding: 4px 8px; font-size: 0.8rem;">Update</button>
                      </form>
                    <% } else { %>
                      <span style="font-size: 0.8rem; color: var(--text-muted); font-style: italic;">Protected</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" style="text-align: center; color: var(--text-muted); padding: var(--space-4);">No users found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
