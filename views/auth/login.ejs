<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="container">
    <div class="auth-wrapper">
      <div class="auth-header">
        <h2>Sign In</h2>
        <p>Access your learning account or instructor dashboard</p>
      </div>

      <%- include('../partials/flash') %>

      <form action="/login" method="POST">
        <div class="form-group">
          <label for="email" class="form-label">Email Address</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-control" 
            placeholder="you@example.com" 
            value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>" 
            required 
            autofocus
          >
        </div>

        <div class="form-group">
          <label for="password" class="form-label">Password</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            class="form-control" 
            placeholder="••••••••" 
            required
          >
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: var(--space-2);">
          Sign In
        </button>
      </form>

      <div style="text-align: center; margin-top: var(--space-4); font-size: 0.9rem; color: var(--text-muted);">
        Don't have an account? <a href="/register" style="font-weight: 600;">Register here</a>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
