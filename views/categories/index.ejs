<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="container">
    <div style="margin-top: var(--space-4);">
      <%- include('../partials/flash') %>
    </div>

    <div class="dashboard-grid">
      <!-- Add Category Form -->
      <aside class="sidebar-card">
        <h3 style="font-size: 1.15rem; margin-bottom: var(--space-3);">Add Category</h3>
        <form action="/categories" method="POST">
          <div class="form-group">
            <label for="category_name" class="form-label">Category Name</label>
            <input type="text" id="category_name" name="category_name" class="form-control" placeholder="e.g. Computer Science" required>
          </div>

          <div class="form-group">
            <label for="description" class="form-label">Description (Optional)</label>
            <textarea id="description" name="description" class="form-control" rows="3" placeholder="Brief category description..."></textarea>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%;">Create Category</button>
        </form>
      </aside>

      <!-- Category List -->
      <section class="main-content-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
          <h2>Platform Categories</h2>
          <span class="user-badge" style="background: var(--ink-navy);"><%= categories.length %> Categories</span>
        </div>

        <% if (categories.length > 0) { %>
          <div style="overflow-x: auto;">
            <table class="data-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Category Name</th>
                  <th>Description</th>
                  <th style="text-align: right;">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% categories.forEach(cat => { %>
                  <tr>
                    <td>#<%= cat.category_id %></td>
                    <td><strong><%= cat.category_name %></strong></td>
                    <td style="color: var(--text-muted);"><%= cat.description || '—' %></td>
                    <td style="text-align: right;">
                      <form action="/categories/<%= cat.category_id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this category?');">
                        <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--danger); border-color: #F5B7B1;">Delete</button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div style="padding: var(--space-6); text-align: center; color: var(--text-muted);">
            No categories created yet. Use the form on the left to add your first course category.
          </div>
        <% } %>
      </section>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
