<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="container" style="padding-top: var(--space-4);">
    <%- include('../partials/flash') %>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
      <div>
        <h1 style="font-size: 2.25rem;">Course Workspace</h1>
        <p style="color: var(--text-muted);">Manage your curriculum, lessons, and publishing status.</p>
      </div>

      <div>
        <a href="/courses/new" class="btn btn-primary">+ Create New Course</a>
      </div>
    </div>

    <% if (courses && courses.length > 0) { %>
      <div style="background: var(--white); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-subtle);">
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Course Title</th>
              <th>Difficulty</th>
              <th>Price</th>
              <th>Lessons</th>
              <th>Status</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% courses.forEach(c => { %>
              <tr>
                <td>#<%= c.course_id %></td>
                <td>
                  <strong><a href="/courses/<%= c.course_id %>" style="color: var(--ink-navy);"><%= c.title %></a></strong>
                  <% if (user.role_name === 'Admin' && c.instructor_name) { %>
                    <br><small style="color: var(--text-muted);">By <%= c.instructor_name %></small>
                  <% } %>
                </td>
                <td style="text-transform: capitalize;"><%= c.level %></td>
                <td><%= c.price > 0 ? `$${parseFloat(c.price).toFixed(2)}` : 'Free' %></td>
                <td><%= c.lesson_count || 0 %> lessons</td>
                <td>
                  <% if (c.status === 'published') { %>
                    <span class="user-badge" style="background: #E8F4F1; color: var(--verdant); border: 1px solid #B2D9D0;">Published</span>
                  <% } else if (c.status === 'draft') { %>
                    <span class="user-badge" style="background: #FFF3CD; color: #856404; border: 1px solid #FFEEBA;">Draft</span>
                  <% } else { %>
                    <span class="user-badge" style="background: #E2E3E5; color: #383D41;">Archived</span>
                  <% } %>
                </td>
                <td style="text-align: right;">
                    <div style="display: flex; justify-content: flex-end; gap: var(--space-1);">
                      <a href="/courses/<%= c.course_id %>/lessons" class="btn btn-secondary btn-sm">Lessons</a>
                      <a href="/courses/<%= c.course_id %>/assignments" class="btn btn-secondary btn-sm">Assignments</a>
                      <a href="/courses/<%= c.course_id %>/exams" class="btn btn-secondary btn-sm">Exams</a>
                      <a href="/courses/<%= c.course_id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                    
                    <form action="/courses/<%= c.course_id %>/status" method="POST" style="display: inline;">
                      <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--ink-navy);">
                        <%= c.status === 'published' ? 'Unpublish' : 'Publish' %>
                      </button>
                    </form>

                    <form action="/courses/<%= c.course_id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this course?');">
                      <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--danger); border-color: #F5B7B1;">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div style="background: var(--white); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-8); text-align: center;">
        <h3 style="font-size: 1.5rem; color: var(--ink-navy); margin-bottom: var(--space-2);">No Courses Created Yet</h3>
        <p style="color: var(--text-muted); max-width: 480px; margin: 0 auto var(--space-4);">
          You haven't published or drafted any courses yet. Start building your first curriculum!
        </p>
        <a href="/courses/new" class="btn btn-primary">+ Create Your First Course</a>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
