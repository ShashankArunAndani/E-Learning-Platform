<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="container">
    <div style="margin-top: var(--space-4);">
      <%- include('../partials/flash') %>
    </div>

    <div style="margin-bottom: var(--space-4);">
      <a href="/dashboard/admin" style="font-size: 0.875rem; color: var(--text-muted); text-decoration: none;">
        &larr; Back to Admin Control Center
      </a>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: var(--space-2); flex-wrap: wrap; gap: var(--space-2);">
        <div>
          <h1 style="font-family: var(--font-display); color: var(--ink-navy); font-size: 2rem;">Orders & Payments</h1>
          <p style="color: var(--text-muted); font-size: 0.95rem;">
            Total platform transactions: <strong><%= orders.length %></strong>
          </p>
        </div>
      </div>
    </div>

    <div class="card" style="background: var(--white); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: var(--space-3); box-shadow: var(--shadow-subtle);">
      <div style="overflow-x: auto;">
        <table class="data-table">
          <thead>
            <tr>
              <th>Order ID</th>
              <th>Customer</th>
              <th>Items</th>
              <th>Coupon</th>
              <th>Subtotal</th>
              <th>Discount</th>
              <th>Total</th>
              <th>Status</th>
              <th>Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (orders && orders.length > 0) { %>
              <% orders.forEach(o => { %>
                <tr>
                  <td><strong>#<%= o.order_id %></strong></td>
                  <td>
                    <strong><%= o.user_name %></strong><br>
                    <small style="color: var(--text-muted);"><%= o.user_email %></small>
                  </td>
                  <td><%= o.item_count %> <%= o.item_count === 1 ? 'course' : 'courses' %></td>
                  <td>
                    <% if (o.coupon_code) { %>
                      <code style="background: var(--parchment); padding: 2px 6px; border-radius: 4px; font-weight: 600; color: var(--gold);"><%= o.coupon_code %></code>
                    <% } else { %>
                      <span style="color: var(--text-muted);">-</span>
                    <% } %>
                  </td>
                  <td>$<%= parseFloat(o.subtotal_amount).toFixed(2) %></td>
                  <td>
                    <% if (parseFloat(o.discount_amount) > 0) { %>
                      <span style="color: var(--verdant);">-$<%= parseFloat(o.discount_amount).toFixed(2) %></span>
                    <% } else { %>
                      $0.00
                    <% } %>
                  </td>
                  <td><strong>$<%= parseFloat(o.total_amount).toFixed(2) %></strong></td>
                  <td>
                    <span class="badge badge-<%= o.status === 'completed' ? 'success' : (o.status === 'failed' ? 'danger' : 'secondary') %>">
                      <%= o.status %>
                    </span>
                  </td>
                  <td><%= new Date(o.created_at).toLocaleDateString() %></td>
                  <td>
                    <a href="/admin/orders/<%= o.order_id %>" class="btn btn-sm btn-secondary" style="padding: 4px 8px; font-size: 0.8rem;">
                      Details
                    </a>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="10" style="text-align: center; color: var(--text-muted); padding: var(--space-4);">
                  No order transactions recorded yet.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
