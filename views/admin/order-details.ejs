<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="container">
    <div style="margin-top: var(--space-4);">
      <%- include('../partials/flash') %>
    </div>

    <div style="margin-bottom: var(--space-4);">
      <a href="/admin/orders" style="font-size: 0.875rem; color: var(--text-muted); text-decoration: none;">
        &larr; Back to Orders List
      </a>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: var(--space-2); flex-wrap: wrap; gap: var(--space-2);">
        <div>
          <h1 style="font-family: var(--font-display); color: var(--ink-navy); font-size: 2rem;">Order #<%= order.order_id %></h1>
          <p style="color: var(--text-muted); font-size: 0.95rem;">
            Placed on <%= new Date(order.created_at).toLocaleString() %> &bull; Status: 
            <span class="badge badge-<%= order.status === 'completed' ? 'success' : (order.status === 'failed' ? 'danger' : 'secondary') %>">
              <%= order.status %>
            </span>
          </p>
        </div>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-4); align-items: start;">
      <!-- Order Items & Course Details -->
      <div class="card" style="background: var(--white); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: var(--space-3); box-shadow: var(--shadow-subtle);">
        <h3 style="font-family: var(--font-display); color: var(--ink-navy); font-size: 1.25rem; margin-bottom: var(--space-3);">Purchased Courses</h3>
        
        <div style="overflow-x: auto;">
          <table class="data-table">
            <thead>
              <tr>
                <th>Course</th>
                <th>Instructor</th>
                <th>Price at Purchase</th>
              </tr>
            </thead>
            <tbody>
              <% if (order.items && order.items.length > 0) { %>
                <% order.items.forEach(item => { %>
                  <tr>
                    <td>
                      <strong><a href="/courses/<%= item.course_id %>" style="color: var(--ink-navy);"><%= item.course_title %></a></strong>
                    </td>
                    <td><%= item.instructor_name %></td>
                    <td>$<%= parseFloat(item.price_at_purchase).toFixed(2) %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="3" style="text-align: center; color: var(--text-muted);">No items attached to this order.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <h3 style="font-family: var(--font-display); color: var(--ink-navy); font-size: 1.25rem; margin-top: var(--space-4); margin-bottom: var(--space-2);">Payment Attempts</h3>
        <% if (order.payments && order.payments.length > 0) { %>
          <div style="overflow-x: auto;">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Payment ID</th>
                  <th>Method</th>
                  <th>Amount</th>
                  <th>Transaction Ref</th>
                  <th>Status</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% order.payments.forEach(p => { %>
                  <tr>
                    <td>#<%= p.payment_id %></td>
                    <td style="text-transform: capitalize;"><%= p.payment_method %></td>
                    <td>$<%= parseFloat(p.amount).toFixed(2) %></td>
                    <td><code style="font-size: 0.8rem;"><%= p.transaction_ref || '-' %></code></td>
                    <td>
                      <span class="badge badge-<%= p.status === 'completed' ? 'success' : (p.status === 'failed' ? 'danger' : 'secondary') %>">
                        <%= p.status %>
                      </span>
                    </td>
                    <td><%= new Date(p.payment_date).toLocaleString() %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p style="color: var(--text-muted); font-size: 0.9rem;">No payment transactions recorded for this order.</p>
        <% } %>
      </div>

      <!-- Customer and Financial Summary Card -->
      <div>
        <div class="card" style="background: var(--parchment); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: var(--space-3); margin-bottom: var(--space-3);">
          <h4 style="color: var(--ink-navy); margin-bottom: var(--space-2); font-size: 1.1rem;">Customer Overview</h4>
          <p style="margin-bottom: var(--space-1);"><strong>Name:</strong> <%= order.user_name %></p>
          <p style="margin-bottom: var(--space-1);"><strong>Email:</strong> <%= order.user_email %></p>
          <p style="margin-bottom: 0;"><strong>User ID:</strong> #<%= order.user_id %></p>
        </div>

        <div class="card" style="background: var(--white); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: var(--space-3); box-shadow: var(--shadow-subtle);">
          <h4 style="color: var(--ink-navy); margin-bottom: var(--space-2); font-size: 1.1rem;">Financial Summary</h4>
          
          <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-1); font-size: 0.95rem;">
            <span style="color: var(--text-muted);">Subtotal:</span>
            <span>$<%= parseFloat(order.subtotal_amount).toFixed(2) %></span>
          </div>

          <% if (order.coupon_code) { %>
            <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-1); font-size: 0.95rem;">
              <span style="color: var(--text-muted);">Coupon (<%= order.coupon_code %>):</span>
              <span style="color: var(--verdant);">- $<%= parseFloat(order.discount_amount).toFixed(2) %></span>
            </div>
          <% } %>

          <hr style="border: 0; border-top: 1px solid var(--border-subtle); margin: var(--space-2) 0;">

          <div style="display: flex; justify-content: space-between; font-weight: 700; font-size: 1.15rem; color: var(--ink-navy);">
            <span>Total:</span>
            <span>$<%= parseFloat(order.total_amount).toFixed(2) %></span>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
