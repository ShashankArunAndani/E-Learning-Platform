<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="container" style="padding-top: var(--space-4); padding-bottom: var(--space-8);">
    <div style="margin-top: var(--space-2);">
      <%- include('../partials/flash') %>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-4); flex-wrap: wrap; gap: var(--space-2);">
      <div>
        <a href="/courses/<%= course.course_id %>/exams" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: none;">
          &larr; Back to Exams
        </a>
        <h1 style="font-size: 2rem; margin-top: var(--space-1);"><%= exam.title %></h1>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Course: <strong><%= course.title %></strong></p>
      </div>
      <span class="user-badge" style="background: var(--ink-navy);"><%= results.length %> Results Recorded</span>
    </div>

    <!-- Exam Meta Card -->
    <div class="sidebar-card" style="margin-bottom: var(--space-6); background: var(--white); border-radius: var(--radius-md);">
      <h3 style="font-size: 1.15rem; margin-bottom: var(--space-2);">Examination Details</h3>
      <div style="display: flex; gap: var(--space-4); font-size: 0.85rem; color: var(--text-muted); flex-wrap: wrap;">
        <div>Total Marks: <strong style="color: var(--ink-navy);"><%= exam.total_marks %> pts</strong></div>
        <div>Duration: <strong style="color: var(--ink-navy);"><%= exam.duration %> minutes</strong></div>
        <div>Date & Time: <strong style="color: var(--ink-navy);"><%= new Date(exam.exam_date).toLocaleString() %></strong></div>
      </div>
    </div>

    <!-- Enter Manual Result Section -->
    <div class="sidebar-card" style="margin-bottom: var(--space-6); background: var(--white); border-radius: var(--radius-md); padding: var(--space-4);">
      <h3 style="font-size: 1.25rem; margin-bottom: var(--space-3); color: var(--ink-navy);">Record Student Result</h3>
      
      <form action="/courses/<%= course.course_id %>/exams/<%= exam.exam_id %>/results" method="POST">
        <div style="display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: var(--space-3); align-items: end;">
          <div class="form-group" style="margin-bottom: 0;">
            <label for="user_id" class="form-label">Select Enrolled Student *</label>
            <select id="user_id" name="user_id" class="form-control" required>
              <option value="" disabled selected>-- Select Student --</option>
              <% if (enrolledStudents && enrolledStudents.length > 0) { %>
                <% enrolledStudents.forEach(student => { %>
                  <option value="<%= student.user_id %>"><%= student.name %> (<%= student.email %>)</option>
                <% }); %>
              <% } else { %>
                <option value="" disabled>No students enrolled yet</option>
              <% } %>
            </select>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label for="marks_obtained" class="form-label">Marks (out of <%= exam.total_marks %>) *</label>
            <input type="number" step="0.01" min="0" max="<%= exam.total_marks %>" id="marks_obtained" name="marks_obtained" class="form-control" placeholder="e.g. 88.5" required>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label for="grade" class="form-label">Grade (Optional)</label>
            <input type="text" id="grade" name="grade" class="form-control" placeholder="e.g. A, B+, Pass">
          </div>

          <div>
            <button type="submit" class="btn btn-primary" <%= (!enrolledStudents || enrolledStudents.length === 0) ? 'disabled' : '' %>>
              Save Result &rarr;
            </button>
          </div>
        </div>
      </form>
    </div>

    <h2 style="font-size: 1.5rem; margin-bottom: var(--space-3);">Published Examination Results</h2>

    <% if (results && results.length > 0) { %>
      <div style="background: var(--white); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); overflow-x: auto; box-shadow: var(--shadow-subtle);">
        <table class="data-table">
          <thead>
            <tr>
              <th>Student Name</th>
              <th>Student Email</th>
              <th>Score Obtained</th>
              <th>Grade</th>
              <th>Recorded Date</th>
            </tr>
          </thead>
          <tbody>
            <% results.forEach(res => { %>
              <tr>
                <td><strong><%= res.student_name %></strong></td>
                <td style="color: var(--text-muted);"><%= res.student_email %></td>
                <td>
                  <strong><%= res.marks_obtained %></strong> / <%= exam.total_marks %> pts
                </td>
                <td>
                  <% if (res.grade) { %>
                    <span class="user-badge" style="background: var(--parchment); color: var(--ink-navy); border: 1px solid var(--border-subtle); font-weight: 700;">
                      <%= res.grade %>
                    </span>
                  <% } else { %>
                    <span style="color: var(--text-muted);">—</span>
                  <% } %>
                </td>
                <td style="color: var(--text-muted);"><%= new Date(res.result_date).toLocaleString() %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">
        <h2>No Results Recorded Yet</h2>
        <p>Use the form above to record exam marks and notify students.</p>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
