<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="container" style="padding-top: var(--space-4);">
    <div style="margin-top: var(--space-2);">
      <%- include('../partials/flash') %>
    </div>

    <div style="margin-bottom: var(--space-4);">
      <h1 style="font-size: 2.25rem;">My Courses</h1>
      <p style="color: var(--text-muted);">Track your enrolled courses and pick up where you left off.</p>
    </div>

    <div class="learn-stats-grid">
      <div class="learn-stat-card">
        <div class="stat-value"><%= stats.total %></div>
        <div class="stat-label">Total Enrolled</div>
      </div>
      <div class="learn-stat-card">
        <div class="stat-value"><%= stats.in_progress %></div>
        <div class="stat-label">In Progress</div>
      </div>
      <div class="learn-stat-card stat-completed">
        <div class="stat-value"><%= stats.completed %></div>
        <div class="stat-label">Completed</div>
      </div>
      <div class="learn-stat-card">
        <div class="stat-value"><%= stats.not_started %></div>
        <div class="stat-label">Not Started</div>
      </div>
    </div>

    <% if (enrollments && enrollments.length > 0) { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-8);">
        <% enrollments.forEach(enrollment => {
          const pct = parseFloat(enrollment.progress_percentage || 0);
          const completedLessons = enrollment.completed_lessons || 0;
          const totalLessons = enrollment.total_lessons || 0;
          const statusClass = enrollment.completion_status === 'completed'
            ? 'status-completed'
            : enrollment.completion_status === 'in_progress'
              ? 'status-in_progress'
              : 'status-not_started';
          const statusLabel = enrollment.completion_status === 'completed'
            ? 'Completed'
            : enrollment.completion_status === 'in_progress'
              ? 'In Progress'
              : 'Not Started';
        %>
          <article class="enrollment-card">
            <div class="enrollment-card-header">
              <div>
                <div style="font-size: 0.75rem; text-transform: capitalize; color: var(--verdant); font-weight: 600; margin-bottom: 4px;">
                  <%= enrollment.level %> Level
                </div>
                <h3 style="font-size: 1.25rem; margin-bottom: 4px;">
                  <a href="/courses/<%= enrollment.course_id %>" style="color: var(--ink-navy); text-decoration: none;">
                    <%= enrollment.course_title %>
                  </a>
                </h3>
                <div style="font-size: 0.85rem; color: var(--text-muted);">By <%= enrollment.instructor_name %></div>
              </div>
              <span class="enrollment-status-badge <%= statusClass %>"><%= statusLabel %></span>
            </div>

            <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
              <%= enrollment.course_description %>
            </p>

            <div>
              <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 6px;">
                <span style="color: var(--text-muted);">
                  <%= completedLessons %> of <%= totalLessons %> lessons
                </span>
                <span style="font-weight: 600; color: var(--verdant);"><%= pct.toFixed(0) %>%</span>
              </div>
              <div class="progress-bar-track">
                <div class="progress-bar-fill" style="width: <%= Math.min(100, pct) %>%;"></div>
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: var(--text-muted); margin-bottom: var(--space-2);">
              <span>Enrolled <%= new Date(enrollment.enrollment_date).toLocaleDateString() %></span>
            </div>

            <div style="display: flex; gap: var(--space-2); margin-bottom: var(--space-3);">
              <a href="/courses/<%= enrollment.course_id %>/assignments" class="btn btn-secondary" style="flex: 1; text-align: center; font-size: 0.85rem; padding: 6px 0;">Assignments</a>
              <a href="/courses/<%= enrollment.course_id %>/exams" class="btn btn-secondary" style="flex: 1; text-align: center; font-size: 0.85rem; padding: 6px 0;">Exams</a>
            </div>

            <a href="/learn/<%= enrollment.course_id %>" class="btn btn-primary" style="width: 100%; text-align: center;">
              <% if (enrollment.completion_status === 'completed') { %>
                Review Course
              <% } else if (enrollment.completion_status === 'in_progress') { %>
                Continue Learning &rarr;
              <% } else { %>
                Start Course &rarr;
              <% } %>
            </a>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <div style="background: var(--white); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-8); text-align: center;">
        <h3 style="font-size: 1.5rem; color: var(--ink-navy); margin-bottom: var(--space-2);">No Enrolled Courses Yet</h3>
        <p style="color: var(--text-muted); max-width: 480px; margin: 0 auto var(--space-4);">
          Purchase a course from the catalog to start learning. Your progress will appear here once enrolled.
        </p>
        <a href="/courses" class="btn btn-primary">Browse Courses</a>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
