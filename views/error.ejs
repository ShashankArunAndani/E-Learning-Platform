<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container" style="padding: var(--space-8) 0; text-align: center;">
    <div style="max-width: 600px; margin: 0 auto; background: var(--white); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-6);">
      <h1 style="font-size: 3rem; color: var(--ink-navy);"><%= (typeof error !== 'undefined' && error.status) ? error.status : 'Error' %></h1>
      <h2 style="font-size: 1.5rem; margin: var(--space-2) 0;"><%= title || 'An error occurred' %></h2>
      <p style="color: var(--text-muted); margin-bottom: var(--space-4);">
        <%= message || 'Something went wrong while processing your request.' %>
      </p>

      <% if (typeof process !== 'undefined' && process.env.NODE_ENV !== 'production' && typeof error !== 'undefined' && error.stack) { %>
        <div style="text-align: left; background: #1E1E1E; color: #D4D4D4; padding: var(--space-3); border-radius: var(--radius-sm); font-family: monospace; font-size: 0.8rem; overflow-x: auto; margin-bottom: var(--space-4);">
          <pre><%= error.stack %></pre>
        </div>
      <% } %>

      <a href="/" class="btn btn-primary">Return to Home Page</a>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
