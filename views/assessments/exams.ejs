<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="container my-5">
  <%- include('../partials/flash') %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Exams: <%= course.title %></h1>
    <a href="<%= role === 'Student' ? '/my-courses' : '/courses/manage' %>" class="btn btn-outline-secondary">Back to Courses</a>
  </div>

  <% if (role === 'Instructor' || role === 'Admin') { %>
    <div class="card mb-5">
      <div class="card-header bg-primary text-white">
        <h3 class="h5 mb-0">Create New Exam</h3>
      </div>
      <div class="card-body">
        <form action="/courses/<%= course.course_id %>/exams" method="POST">
          <div class="mb-3">
            <label for="title" class="form-label">Exam Title</label>
            <input type="text" class="form-control" id="title" name="title" required>
          </div>
          <div class="row mb-3">
            <div class="col-md-4">
              <label for="total_marks" class="form-label">Total Marks</label>
              <input type="number" step="0.01" min="1" class="form-control" id="total_marks" name="total_marks" required>
            </div>
            <div class="col-md-4">
              <label for="duration" class="form-label">Duration (minutes)</label>
              <input type="number" min="1" class="form-control" id="duration" name="duration" required>
            </div>
            <div class="col-md-4">
              <label for="exam_date" class="form-label">Exam Date</label>
              <input type="datetime-local" class="form-control" id="exam_date" name="exam_date" required>
            </div>
          </div>
          <button type="submit" class="btn btn-success">Create Exam</button>
        </form>
      </div>
    </div>
  <% } %>

  <h2 class="mb-3">Exam List</h2>
  <% if (exams && exams.length > 0) { %>
    <div class="row row-cols-1 row-cols-md-2 g-4">
      <% exams.forEach(exam => { 
           const res = role === 'Student' ? userResults[exam.exam_id] : null;
      %>
        <div class="col">
          <div class="card h-100 border-primary">
            <div class="card-body">
              <h5 class="card-title"><%= exam.title %></h5>
              <ul class="list-unstyled">
                <li><strong>Total Marks:</strong> <%= exam.total_marks %></li>
                <li><strong>Duration:</strong> <%= exam.duration %> mins</li>
                <li><strong>Date:</strong> <%= new Date(exam.exam_date).toLocaleString() %></li>
              </ul>
              
              <% if (role === 'Student') { %>
                <hr>
                <% if (res) { %>
                  <div class="alert alert-success p-3 mb-0">
                    <h5 class="alert-heading">Result Published</h5>
                    <strong>Marks:</strong> <%= res.marks_obtained %> / <%= exam.total_marks %><br>
                    <strong>Grade:</strong> <%= res.grade || 'N/A' %>
                  </div>
                <% } else { %>
                  <div class="alert alert-secondary p-2 mb-0">
                    Result pending or not yet entered.
                  </div>
                <% } %>
              <% } else if (role === 'Instructor' || role === 'Admin') { %>
                <hr>
                <a href="/courses/<%= course.course_id %>/exams/<%= exam.exam_id %>" class="btn btn-outline-primary btn-sm">Enter Results</a>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="alert alert-info">No exams created for this course yet.</div>
  <% } %>

</main>

<%- include('../partials/footer') %>
